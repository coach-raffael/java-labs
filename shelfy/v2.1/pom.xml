<?xml version="1.0" encoding="UTF-8"?>
<!-- shelfy 2.1: the console library as a Maven project (Day 3, Module 10).
     Build and test:  ./mvnw verify        Run:  java -cp target/classes shelfy.Main -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.coachraffael</groupId>
  <artifactId>shelfy</artifactId>
  <version>2.1.0</version>
  <packaging>jar</packaging>
  <name>shelfy</name>
  <description>A small library that lends books and audiobooks. Example app of the course Java Programming Fundamentals.</description>

  <properties>
    <!-- Compile for Java 25: the compiler rejects anything the JDK 25 class library does not have. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The JUnit BOM pins the versions of all JUnit artifacts to one release. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JUnit Jupiter: @Test, Assertions, @ParameterizedTest. Scope test: not part of the program. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <!-- Module 16.8: let the compiler warn about raw types and unchecked casts.
               "serial" is switched off: it only asks for a serialVersionUID in every exception class. -->
          <compilerArgs>
            <arg>-Xlint:all,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <!-- Surefire runs the tests in the "test" phase and prints one line per test class. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
